FROM node:22-slim

WORKDIR /app

# Copy package files first to leverage cache
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY . .

# Expose ports for both services (frontend: 3000, backend: 3001)
EXPOSE 3000 3001

# Default command (overridden in docker-compose)
CMD ["npm", "run", "dev"]
