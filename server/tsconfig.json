{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "types": ["node", "express", "cors"],
    "outDir": "../dist-server",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules"]
}
